<Window x:Class="VPNSL.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="КВН — VPN" Width="960" Height="690" MinWidth="820" MinHeight="590"
        WindowStartupLocation="CenterScreen" Icon="/Assets/KVN.ico" Background="{StaticResource Bg}">
  <Grid Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <!-- Side navigation: only the three actions used every day. -->
    <Border Grid.Column="0" Background="#F0F5FD" BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,1,0" Padding="14,22,14,18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="7,0,7,30">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Image Source="/Assets/KVN.png" Width="48" Height="48"
                   Stretch="Uniform" SnapsToDevicePixels="True"/>
            <StackPanel Margin="12,3,0,0">
              <TextBlock Text="КВН" FontWeight="Bold" FontSize="24" Foreground="{StaticResource Text}"/>
              <TextBlock Text="VPN-клиент" FontSize="12" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="NavBar" Margin="0,76,0,0" VerticalAlignment="Top">
          <Button Content="⌂  Подключение" Tag="connection" Click="Nav_Click" Style="{StaticResource NavButton}"
                  Height="52" FontSize="15" HorizontalContentAlignment="Left" Margin="0,0,0,9"/>
          <Button Content="▣  Конфигурации" Tag="profiles" Click="Nav_Click" Style="{StaticResource NavButton}"
                  Height="52" FontSize="15" HorizontalContentAlignment="Left" Margin="0,0,0,9"/>
          <Button Content="◈  Диагностика" Tag="diagnostics" Click="Nav_Click" Style="{StaticResource NavButton}"
                  Height="52" FontSize="15" HorizontalContentAlignment="Left" Margin="0,0,0,9"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,20,35,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="25"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<!-- Keep only the status in the upper-right corner. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,16,0,0">
          <Ellipse x:Name="HeaderStatusDot" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="HeaderStatus" Text="Отключено" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid x:Name="ConnectionPage">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,12,0,15">
            <TextBlock Text="Протокол подключения" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{StaticResource Text}" Margin="0,0,0,12"/>
            <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="12"
                    Background="{StaticResource Surface2}" Padding="3">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AwgModeRadio" Content="AmneziaWG 3.1" Tag="AWG" GroupName="KvnProtocol"
                             Checked="KvnRadio_Checked" Margin="14,8" FontSize="14"/>
                <RadioButton x:Name="CsqttModeRadio" Content="CSQTT" Tag="CSQTT" GroupName="KvnProtocol"
                             Checked="KvnRadio_Checked" Margin="14,8" FontSize="14"/>
              </StackPanel>
            </Border>
            <ComboBox x:Name="TransportSelector" Visibility="Collapsed" SelectedIndex="0"
                      SelectionChanged="TransportSelector_SelectionChanged">
              <ComboBoxItem Content="CSQTT" Tag="CSQTT"/>
              <ComboBoxItem Content="AmneziaWG 3.1" Tag="AWG"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="360" Margin="0,0,0,10">
            <TextBlock Text="Конфигурация" FontSize="12" Foreground="{StaticResource Muted}" Margin="2,0,0,4"/>
            <ComboBox x:Name="ActiveProfileSelector" Height="39"
                      SelectionChanged="ActiveProfileSelector_SelectionChanged"/>
            <TextBlock x:Name="EmptyProfileHint" Text="Добавьте конфигурацию в левом меню" FontSize="12"
                       Foreground="{StaticResource Muted}" Margin="2,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <!-- The circle itself is the only connect/disconnect control. -->
          <Button Grid.Row="2" x:Name="ConnectButton" Click="ConnectButton_Click"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="214" Height="214" Cursor="Hand"
                  ToolTip="Подключить или отключить VPN"
                  AutomationProperties.Name="Подключить или отключить VPN">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Grid>
                  <Ellipse x:Name="RoundSurface" Fill="{StaticResource Surface2}"
                           Stroke="{StaticResource BorderStrong}" StrokeThickness="4"/>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RoundSurface" Property="Fill" Value="{StaticResource Surface3}"/>
                    <Setter TargetName="RoundSurface" Property="Stroke" Value="{StaticResource Primary}"/>
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="RoundSurface" Property="Fill" Value="{StaticResource Pressed}"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="RoundSurface" Property="Opacity" Value="0.6"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="PowerGlyph" Text="⏻" FontFamily="Segoe UI Symbol" FontSize="56"
                         Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ConnectionStatus" Text="Отключено" FontSize="21"
                         FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                         HorizontalAlignment="Center" TextWrapping="Wrap" Width="174" TextAlignment="Center"/>
              <TextBlock x:Name="UptimeText" Text="00:00:00" FontSize="12"
                         Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
          </Button>
          <!-- Hidden compatibility controls; no technical settings on the main screen. -->
          <StackPanel Visibility="Collapsed" Grid.Row="3">
            <TextBlock x:Name="ObfsStatus"/><TextBlock x:Name="HashesStatus"/>
            <TextBlock x:Name="WorkersStatus"/><TextBlock x:Name="UpStatus"/>
            <TextBlock x:Name="DownStatus"/>
            <TextBlock x:Name="CsqttTransportHint"/>
            <StackPanel x:Name="AwgProfilePanel">
              <TextBox x:Name="AwgProfileBox"/>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Grid x:Name="ProfilesPage" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6,4,10,20">
              <TextBlock Text="Конфигурации" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <TextBlock Text="Импортируйте файл один раз. Для подключения достаточно выбрать его на главном экране."
                         Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20"/>
              <WrapPanel Margin="0,0,0,16">
                <Button Content="+  AmneziaWG (.conf)" Click="ImportAwgProfile_Click"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,9,6"/>
                <Button Content="+  CSQTT (.kvn)" Click="ImportCsqttProfile_Click" Margin="0,0,9,6"/>
              </WrapPanel>
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                      BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="Сохранённые подключения" FontSize="15" FontWeight="SemiBold"
                             Margin="0,0,0,8"/>
                  <ListBox x:Name="ProfilesList" Height="175" SelectionChanged="ProfilesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,5">
                          <TextBlock Text="{Binding Transport}" Width="80" FontWeight="SemiBold"
                                     Foreground="{StaticResource PrimaryDark}"/>
                          <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
              <WrapPanel Margin="0,6,0,4">
                <Button Content="Выбрать" Click="ChooseProfile_Click" Margin="0,0,10,4"/>
                <Button Content="Удалить из КВН" Click="DeleteProfile_Click" Margin="0,0,10,4"/>
              </WrapPanel>
              <TextBlock x:Name="ProfileInfoText" Text="Секреты CSQTT защищены Windows DPAPI."
                         FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,18"/>
              <Button Content="Дополнительные параметры CSQTT" Click="OpenAdvancedCsqtt_Click"
                      HorizontalAlignment="Left" FontSize="12"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      <Grid x:Name="SettingsPage" Visibility="Collapsed" Background="{StaticResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
          <StackPanel Margin="4,2,4,12">
            <TextBlock Text="Туннель" Style="{StaticResource SectionTitle}"/>
            <!-- Internals for the legacy CSQTT engine; values come solely
                 from the imported .kvn. Never show editable duplicate secrets. -->
            <StackPanel Visibility="Collapsed">
              <TextBox x:Name="PeerBox"/>
              <PasswordBox x:Name="PasswordBox"/>
              <TextBox x:Name="VkHashesBox"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Параметры клиента" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Воркеры" Foreground="{StaticResource Muted}"/><TextBox x:Name="WorkersBox"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Транспорт TURN" Foreground="{StaticResource Muted}"/><ComboBox x:Name="TurnTransportBox"><ComboBoxItem Content="udp"/><ComboBoxItem Content="tcp_tls"/></ComboBox></StackPanel>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="TURN host (необязательно)" Foreground="{StaticResource Muted}"/><TextBox x:Name="TurnHostBox"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="TURN port" Foreground="{StaticResource Muted}"/><TextBox x:Name="TurnPortBox"/></StackPanel>
                </Grid>
                <TextBlock Text="SNI" Foreground="{StaticResource Muted}"/><TextBox x:Name="SniBox"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Маскировка" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ObfsBox"><ComboBoxItem Content="audio"/><ComboBoxItem Content="video"/><ComboBoxItem Content="none"/></ComboBox></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="VK auth" Foreground="{StaticResource Muted}"/><ComboBox x:Name="VkAuthBox"><ComboBoxItem Content="vkcalls"/><ComboBoxItem Content="captcha"/></ComboBox></StackPanel>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Captcha" Foreground="{StaticResource Muted}"/><ComboBox x:Name="CaptchaBox"><ComboBoxItem Content="auto"/><ComboBoxItem Content="rjs"/><ComboBoxItem Content="wv"/></ComboBox></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Fingerprint" Foreground="{StaticResource Muted}"/><ComboBox x:Name="FingerprintBox"><ComboBoxItem Content="chrome"/><ComboBoxItem Content="firefox"/></ComboBox></StackPanel>
                </Grid>
                <TextBlock Text="Client IDs" Foreground="{StaticResource Muted}"/><TextBox x:Name="ClientIdsBox"/>
                <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Routing -->
      <Grid x:Name="RoutingPage" Visibility="Collapsed" Background="{StaticResource Bg}">
        <Grid Margin="4,2,4,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="Маршрутизация" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <StackPanel>
                <Border Background="#E9F7EF" BorderBrush="#A7D9BA" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
                  <TextBlock Text="FULL-TUNNEL IPv4 ВКЛЮЧЁН ПО УМОЛЧАНИЮ" Foreground="{StaticResource Success}" FontWeight="SemiBold"/>
                </Border>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Описание" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBox x:Name="RouteNameBox" Margin="0,4,0,8"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,6,0">
                    <TextBlock Text="IPv4 / CIDR" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBox x:Name="RouteCidrBox" Margin="0,4,0,8"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="6,0,0,0">
                    <TextBlock Text="Направление" Foreground="{StaticResource Muted}" FontSize="11"/>
                    <ComboBox x:Name="RouteTargetBox" Margin="0,4,0,8">
                      <ComboBoxItem Content="Напрямую" Tag="MOBILE"/>
                      <ComboBoxItem Content="Через VPNSL" Tag="VPNSL"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <Button Content="Добавить правило" Style="{StaticResource PrimaryButton}" Click="AddRoute_Click" Margin="0,0,0,6"/>
                <WrapPanel>
                  <Button Content="Загрузить .bat/.txt/.list" Click="ImportRoutes_Click" ToolTip="Загруженный файл получит направление, выбранное выше"/>
                  <Button Content="Выгрузить все маршруты (.bat)" Click="ExportRoutes_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Генератор BAT по имени сайта" FontWeight="SemiBold"/>
                <TextBlock Text="Найдите IPv4 сайта и затем импортируйте BAT как «Напрямую» или «Через VPNSL»." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="SiteBox" Grid.Column="0" Margin="0,4,6,4"/><Button Grid.Column="1" Content="Найти IPv4" Click="ResolveSite_Click"/></Grid>
                <TextBlock x:Name="SiteResultText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Button x:Name="SaveSiteBatButton" Content="Сохранить BAT сайта" Click="SaveSiteBat_Click" IsEnabled="False" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Поиск по маршрутам" Foreground="{StaticResource Muted}" FontSize="11"/>
            <TextBox x:Name="RouteSearchBox" Grid.Row="1" Margin="0,3,0,0" MinHeight="32" Padding="9,5" TextChanged="RouteSearchBox_TextChanged"/>
          </Grid>

          <ListBox x:Name="RoutesList" Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="9" Padding="8,6" Margin="0,2">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" Checked="RouteEnabled_Changed" Unchecked="RouteEnabled_Changed"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding RouteCountDisplay}" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock Text="  •  " Foreground="{StaticResource Muted2}" FontSize="11"/>
                        <TextBlock Text="{Binding EnabledDisplay}" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock Text="  •  " Foreground="{StaticResource Muted2}" FontSize="11"/>
                        <TextBlock Text="{Binding Routes[0]}" Foreground="{StaticResource Muted2}" FontSize="11"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="{Binding TargetDisplay}" Tag="{Binding Id}" Click="ChangeRouteTarget_Click" Style="{StaticResource RouteTargetButton}" MinHeight="30" Padding="10,4" Margin="3,0"/>
                      <Button Content="Удалить" Tag="{Binding Id}" Click="DeleteRoute_Click" Style="{StaticResource DangerButton}" MinHeight="30" Padding="10,4" Margin="3,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>

      <!-- Server -->
      <Grid x:Name="ServerPage" Visibility="Collapsed" Background="{StaticResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
          <StackPanel Margin="4,2,4,12">
            <TextBlock Text="Установка на сервер" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Установка и удаление сервера VPNSL по SSH. В Windows-пакет входят серверные бинарники amd64, arm64 и armv7." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="SSH" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Адрес VPS" Foreground="{StaticResource Muted}"/><TextBox x:Name="SshHostBox"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="SSH port" Foreground="{StaticResource Muted}"/><TextBox x:Name="SshPortBox" Text="22"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="SSH user" Foreground="{StaticResource Muted}"/><TextBox x:Name="SshUserBox" Text="root"/></StackPanel>
                </Grid>
                <TextBlock Text="SSH пароль" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="SshPasswordBox"/>
                <TextBlock Text="Приватный ключ (необязательно)" Foreground="{StaticResource Muted}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="SshKeyPathBox" Grid.Column="0" Margin="0,4,6,8"/><Button Grid.Column="1" Content="Выбрать…" Click="BrowseSshKey_Click"/></Grid>
                <TextBlock Text="Passphrase ключа" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="SshKeyPassphraseBox"/>
                <Button Content="Проверить SSH" Click="TestSsh_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="VPNSL Server" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Peer port" Foreground="{StaticResource Muted}"/><TextBox x:Name="ServerPeerPortBox" Text="46000"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Web port" Foreground="{StaticResource Muted}"/><TextBox x:Name="ServerWebPortBox" Text="46002"/></StackPanel>
                </Grid>
                <TextBlock Text="Основной пароль VPNSL" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="ServerMainPasswordBox"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,7,0"><TextBlock Text="Логин web-панели" Foreground="{StaticResource Muted}"/><TextBox x:Name="ServerWebLoginBox"/></StackPanel>
                  <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Пароль web-панели" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="ServerWebPasswordBox"/></StackPanel>
                </Grid>
                <CheckBox x:Name="ServerDockerBox" Content="Установить в Docker" Margin="0,8"/>
                <TextBlock x:Name="ServerDeployStatusText" Text="Готово" Foreground="{StaticResource Muted}" Margin="0,4"/>
                <ProgressBar x:Name="ServerProgress" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,4,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="InstallServerButton" Grid.Column="0" Content="Установить / переустановить" Style="{StaticResource PrimaryButton}" Click="InstallServer_Click"/>
                  <Button x:Name="UninstallServerButton" Grid.Column="1" Content="Удалить" Click="UninstallServer_Click" Style="{StaticResource DangerButton}"/>
                </Grid>
                <Button Content="Открыть web-панель" Click="OpenServerPanel_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Logs -->
      <Grid x:Name="LogsPage" Visibility="Collapsed" Background="{StaticResource Bg}" Margin="4,2,4,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="Диагностика" Style="{StaticResource SectionTitle}" Margin="0"/>
          <TextBlock Text="Журнал подключений и сетевой диагностики" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
          <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Text}" Background="{StaticResource LogBg}" BorderThickness="0" Margin="0"/>
        </Border>
        <Button Grid.Row="2" Content="Очистить журнал" Click="ClearLogs_Click" HorizontalAlignment="Right" Margin="0,8,0,0"/>
      </Grid>

      <!-- Info -->
      <Grid x:Name="InfoPage" Visibility="Collapsed" Background="{StaticResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
          <StackPanel Margin="4,2,4,12">
            <TextBlock Text="Информация" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="VPNSL for Windows" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimarySoft}"/>
                <TextBlock Text="Версия 1.0.3" Foreground="{StaticResource Muted}" Margin="0,3,0,14"/>
                <TextBlock Text="Windows-адаптация VPNSL с full-tunnel IPv4 по умолчанию и корректирующими маршрутами «Напрямую» / «Через VPNSL». VPN-протокол и Rust-клиент сохранены на базе исходного проекта." TextWrapping="Wrap" LineHeight="20"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Разработчики" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Windows adaptation / UI" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="Sazhaev-IA" FontWeight="SemiBold" Foreground="{StaticResource PrimarySoft}"/></Grid>
