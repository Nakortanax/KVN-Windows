<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\KVN.ico</ApplicationIcon>
    <StartupObject>VPNSL.Windows.Program</StartupObject>
    <AssemblyName>KVN.Windows</AssemblyName>
    <RootNamespace>VPNSL.Windows</RootNamespace>
    <Version>0.2.1-lab</Version>
    <FileVersion>0.2.1.0</FileVersion>
    <Product>КВН — AmneziaWG / CSQTT</Product>
    <Authors>Sazhaev-IA</Authors>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\KVN.ico" />
    <Resource Include="Assets\KVN.png" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
